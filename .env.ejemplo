# ── Copiar a .env y completar. NUNCA subir .env a Git ni compartirlo. ─────────────────

# Secreto para firmar sesiones y seudonimizar los IDs del colegio (mín. 32 caracteres).
# Generar con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠ Guárdalo en un lugar seguro: si se pierde, el sistema ya no reconoce a los estudiantes en las nuevas cargas.
VOCACIONAL_SECRETO=

# Dominio(s) por los que se accede (separados por coma). localhost es necesario para el chequeo de salud.
VOCACIONAL_HOSTS=vocacional.tudominio.com,localhost,127.0.0.1,app

# Nombre que aparece en la cabecera
VOCACIONAL_COLEGIO=Nombre del Colegio

# true detrás de HTTPS (Cloudflare). Solo false para pruebas locales sin HTTPS.
VOCACIONAL_COOKIE_SEGURA=true

# Duración de la sesión (horas) y vigencia por defecto de los códigos del test (días)
VOCACIONAL_HORAS_SESION=8
VOCACIONAL_DIAS_CODIGO=30

# Respaldo diario: hora (0-23) y cuántos conservar
VOCACIONAL_HORA_RESPALDO=2
VOCACIONAL_RESPALDOS_CONSERVAR=30

# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels → tu túnel → Install connector)
CLOUDFLARE_TUNNEL_TOKEN=
